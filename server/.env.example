# Raahi Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string — paste yours in .env, never here
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/raahi?retryWrites=true&w=majority

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-long-random-secret>
JWT_EXPIRES_IN=7d

# React frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
